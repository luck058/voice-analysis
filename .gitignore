# Generated by the harness. The authored documents (todo.md,
# architecture.md, harness.toml, .harness-project.toml) are deliberately NOT
# ignored. Neither is ledger/, the audit trail — commit it.
.env
runs/
workspaces/
trajectories/
snapshots/
verification-results/
# Regenerable: the response cache and cached baselines. Always safe to delete.
cache/
# A git-backed project's clone and the harness's worktrees (design D4). The
# clone is its own repository; nesting it in this one would be a mess.
repo/
worktrees/
evals/results.json
evals/scaffold_results_*.json
